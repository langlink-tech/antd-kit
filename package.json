{
  "name": "@langlink-tech/antd-kit",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "LangLink shared Ant Design component patterns",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./pro-table": {
      "types": "./dist/pro-table.d.ts",
      "import": "./dist/pro-table.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./s2": {
      "types": "./dist/s2.d.ts",
      "import": "./dist/s2.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stamp-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "node scripts/assert-pack.mjs",
    "verify": "pnpm release:status && pnpm typecheck && pnpm test && pnpm pack:check && pnpm rsc:check",
    "rsc:check": "node scripts/assert-rsc.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:status": "node scripts/assert-changeset-status.mjs"
  },
  "peerDependencies": {
    "antd": "^6.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@ant-design/pro-components": "3.1.14-6",
    "@antv/s2": "2.7.2"
  },
  "devDependencies": {
    "@ant-design/pro-components": "3.1.14-6",
    "@antv/s2": "2.7.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "antd": "6.6.2",
    "jsdom": "^27.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "@changesets/cli": "3.0.2"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependenciesMeta": {
    "@ant-design/pro-components": {
      "optional": true
    },
    "@antv/s2": {
      "optional": true
    }
  }
}
