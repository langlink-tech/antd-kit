{
  "name": "@langlink-tech/antd-kit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "LangLink shared Ant Design component patterns",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "node scripts/assert-pack.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm pack:check"
  },
  "peerDependencies": {
    "antd": "^6.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "antd": "6.6.2",
    "jsdom": "^27.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
